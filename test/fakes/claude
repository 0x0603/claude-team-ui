#!/usr/bin/env bash
# Fake claude for the tests. Calls no model. Mimics what Claude Code 2.1.311 does (docs/verify.md):
# - "claude --version"            prints a version
# - "claude agents --json"        prints $CLAUDE_HOME/fake-agents.json, or []
# - "claude -p ..."               prints a json result with structured_output; with --output-format stream-json
#                                 (the assistant) it hands over to claude-print.mjs next to this file
# - otherwise, the lead          prints args and env, splits one teammate pane, writes a team config with its pane id,
#                                 then reads lines: "perm" → permission screen (Enter allows, Esc denies, and the
#                                 prompt is erased like Claude Code does), "trust" → trust screen,
#                                 "/exit" → exit menu while a teammate is alive, anything else → "› got: <line>"
#   The lead also writes a transcript like the real one, under $CLAUDE_HOME/projects/<cwd with every non-alphanumeric
#   as "-">/<session>.jsonl: an agent-name record with its --name, one user record per input (a bracketed paste counts
#   as one), "say X" adds an assistant text record "X", "tool Name" adds a tool_use record and its tool_result.
case "${1:-}" in
  --version) echo "2.1.311 (Claude Code) [fake]"; exit 0;;
  agents) cat "$CLAUDE_HOME/fake-agents.json" 2>/dev/null || echo '[]'; exit 0;;
  -p) for a in "$@"; do [ "$a" = "stream-json" ] && exec node "$(dirname "$0")/claude-print.mjs" "$@"; done
      printf '%s\n' '{"type":"result","result":"done","structured_output":{"title":"Speed up the report page and add CSV export","body":"## Context\nThe report page is slow.\n\n## Goal\n- Faster filtering\n\n## Acceptance criteria\n- [ ] Filtering one month takes under 1 s"}}'
      exit 0;;
esac

# A permission prompt; the answer is one key, then the prompt's 7 lines are erased
perm_prompt() {
  printf 'Bash command\n  npm test\nThis command requires approval\nDo you want to proceed?\n❯ 1. Yes\n  2. No\nEsc to cancel\n'
  IFS= read -rsn1 key
  printf '\033[7A\033[J'
  if [ "$key" = $'\e' ]; then echo "  ⎿ Denied by the user"; else printf '⏺ Bash(npm test)\n  ⎿ ok\n'; fi
}

if [ "${FAKE_TEAMMATE:-}" = 1 ]; then
  echo "teammate up  API_KEY=${ANTHROPIC_API_KEY:-<unset>} CTU_CART=${CTU_CART:-<unset>} NESTED=${CLAUDECODE:-<unset>}"
  while IFS= read -r line; do
    case "$line" in
      perm*) perm_prompt;;
      *) echo "› got: $line";;
    esac
  done
  exit 0
fi

echo "✻ Welcome to Claude Code (fake)  args: $*"
echo "  cwd: $(pwd)   TEST_VAR=${TEAM_UI_TEST_VAR:-<unset>} AGENT_TEAMS=${CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS:-} API_KEY=${ANTHROPIC_API_KEY:-<unset>} CTU_CART=${CTU_CART:-<unset>} NESTED=${CLAUDECODE:-<unset>} NODE=$(node -v 2>/dev/null)"
echo "❯ "
printf '\033[?2004h' # bracketed paste on, like Claude Code: tmux then brackets a pasted prompt, so it is one record

# ---- Transcript ----
NAME=""
prev=""
for a in "$@"; do [ "$prev" = "--name" ] && NAME="$a"; prev="$a"; done
SESSION_ID="${FAKE_SESSION_ID:-fake-$$}"
TRANSCRIPT="$CLAUDE_HOME/projects/$(pwd -P | sed 's/[^a-zA-Z0-9]/-/g')/$SESSION_ID.jsonl"
mkdir -p "$(dirname "$TRANSCRIPT")"
seq=0
# rec <kind> <text> [tool]: kind is user, assistant or tool (a tool_use followed by its tool_result)
rec() {
  seq=$((seq + 1))
  REC_KIND="$1" REC_TEXT="$2" REC_TOOL="${3:-}" REC_SEQ="$seq" REC_SID="$SESSION_ID" REC_NAME="$NAME" node -e '
    const { REC_KIND: kind, REC_TEXT: text, REC_TOOL: tool, REC_SEQ: seq, REC_SID: sid, REC_NAME: name } = process.env;
    const ts = new Date().toISOString();
    const base = { parentUuid: null, isSidechain: false, sessionId: sid, version: "2.1.311" };
    const lines = [];
    if (kind === "name") lines.push({ type: "agent-name", agentName: name, sessionId: sid });
    else if (kind === "user") lines.push({ ...base, type: "user", message: { role: "user", content: text }, uuid: `u-${seq}`, timestamp: ts, promptSource: "typed" });
    else if (kind === "assistant") lines.push({ ...base, type: "assistant", message: { model: "fake", id: `msg_${seq}`, type: "message", role: "assistant", content: [{ type: "text", text }] }, uuid: `a-${seq}`, timestamp: ts });
    else if (kind === "tool") {
      lines.push({ ...base, type: "assistant", message: { model: "fake", id: `msg_${seq}`, type: "message", role: "assistant", content: [{ type: "tool_use", id: `toolu_${seq}`, name: tool, input: { text } }] }, uuid: `a-${seq}`, timestamp: ts });
      lines.push({ ...base, type: "user", message: { role: "user", content: [{ tool_use_id: `toolu_${seq}`, type: "tool_result", content: "ok" }] }, uuid: `r-${seq}`, timestamp: ts });
    }
    require("fs").appendFileSync(process.argv[1], lines.map(l => JSON.stringify(l) + "\n").join(""));
  ' "$TRANSCRIPT"
}
rec name ""

TEAM_DIR=""
if [ -n "${TMUX:-}" ]; then
  sleep 0.5
  pane=$(tmux split-window -h -d -P -F '#{pane_id}' "printf '\033]2;✳ general-purpose\033\\\\'; FAKE_TEAMMATE=1 exec $0 teammate")
  TEAM_DIR="$CLAUDE_HOME/teams/session-fake$$"
  mkdir -p "$TEAM_DIR"
  printf '{"name":"session-fake%s","createdAt":%s000,"leadSessionId":"fake-%s","members":[{"name":"team-lead","agentType":"team-lead","tmuxPaneId":"leader","cwd":"%s","backendType":"in-process"},{"name":"planner-a","agentType":"general-purpose","model":"sonnet","tmuxPaneId":"%s","cwd":"%s","backendType":"tmux","isActive":true,"prompt":"You are teammate planner-a."}]}\n' \
    "$$" "$(date +%s)" "$$" "$(pwd -P)" "$pane" "$(pwd -P)" > "$TEAM_DIR/config.json"
fi
trusting=0
paste=""     # lines of a bracketed paste, until its end marker: one user record, like Claude Code's pasted content
pasting=0
while IFS= read -r line; do
  if [ "$trusting" = 1 ]; then
    trusting=0
    if [ "$line" = $'\e[B' ]; then echo "TRUSTED"; else echo "EXITED ON TRUST"; exit 0; fi
    continue
  fi
  case "$line" in
    $'\e[200~'*) pasting=1; paste="${line#$'\e[200~'}"; echo "› got: ${paste%%$'\e[201~'*}"
      case "$line" in *$'\e[201~'*) pasting=0; rec user "${paste%%$'\e[201~'*}";; esac
      continue;;
  esac
  if [ "$pasting" = 1 ]; then
    paste="$paste"$'\n'"${line%%$'\e[201~'*}"
    case "$line" in *$'\e[201~'*) pasting=0; rec user "$paste";; esac
    continue
  fi
  [ -n "$line" ] && rec user "$line"
  case "$line" in
    perm*) perm_prompt;;
    say\ *) echo "⏺ ${line#say }"; rec assistant "${line#say }";;
    tool\ *) for t in ${line#tool }; do echo "⏺ $t(…)"; rec tool "x" "$t"; done;;
    trust*) printf ' Accessing workspace:\n Quick safety check: Is this a project you created or one you trust?\n ❯ No, exit\n   Yes, I trust this folder\n Enter to confirm · Esc to cancel\n'; trusting=1;;
    /exit)
      if [ -n "$TEAM_DIR" ]; then
        printf '   subagent · planner-a\n   ❯ 1. Exit and stop tasks\n     2. Move to background and exit\n     3. Stay\n   Enter to confirm · Esc to cancel\n'
        IFS= read -r _
        rm -rf "$TEAM_DIR"
      fi
      echo "bye"; exit 0;;
    *) echo "› got: $line";;
  esac
done
